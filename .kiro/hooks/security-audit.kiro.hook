{
  "enabled": true,
  "name": "Security Audit",
  "description": "Comprehensive security audit of the codebase",
  "version": "1.0",
  "when": {
    "type": "manual"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Perform a comprehensive security audit:\n\n1. **Dependencies**: Run `composer audit` to check for vulnerabilities\n2. **Authentication**: Review authentication and authorization implementations\n3. **Input Validation**: Validate input sanitization and Form Requests\n4. **CSRF Protection**: Ensure CSRF protection is properly implemented\n5. **SQL Injection**: Check for raw SQL queries with user input\n6. **Environment**: Review environment variable security\n\nProvide specific security recommendations and fixes."
  }
}