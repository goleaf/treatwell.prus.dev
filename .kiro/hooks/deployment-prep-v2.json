{
  "name": "Advanced Deployment Preparation v2",
  "description": "Comprehensive deployment readiness system with automated checks, optimization, and rollback preparation",
  "version": "2.0",
  "enabled": true,
  "priority": 7,
  "trigger": {
    "type": "manual",
    "additionalTriggers": [
      {
        "type": "git_tag",
        "pattern": "v*.*.*",
        "description": "Trigger on version tags"
      },
      {
        "type": "branch_push",
        "branches": ["main", "production", "release/*"]
      }
    ]
  },
  "preValidation": [
    {
      "type": "environment_check",
      "checks": [
        {
          "command": "git --version",
          "required": true,
          "errorMessage": "Git not available"
        },
        {
          "command": "composer --version",
          "required": true,
          "errorMessage": "Composer not available"
        },
        {
          "command": "npm --version",
          "required": false,
          "warningMessage": "npm not available - frontend assets may not be optimized"
        }
      ]
    },
    {
      "type": "git_status_check",
      "checks": [
        {
          "type": "clean_working_directory",
          "errorMessage": "Working directory has uncommitted changes"
        },
        {
          "type": "branch_up_to_date",
          "errorMessage": "Branch is not up to date with remote"
        }
      ]
    }
  ],
  "deploymentChecks": {
    "codeQuality": {
      "enabled": true,
      "priority": "critical",
      "checks": [
        {
          "name": "code_formatting",
          "command": "vendor/bin/pint --test",
          "description": "Verify code formatting compliance",
          "required": true
        },
        {
          "name": "syntax_validation",
          "command": "find app -name '*.php' -exec php -l {} \\;",
          "description": "Validate PHP syntax",
          "required": true
        },
        {
          "name": "static_analysis",
          "command": "vendor/bin/phpstan analyse --no-progress",
          "description": "Run static code analysis",
          "optional": true
        }
      ]
    },
    "testing": {
      "enabled": true,
      "priority": "critical",
      "checks": [
        {
          "name": "unit_tests",
          "command": "php artisan test --testsuite=Unit",
          "description": "Run unit test suite",
          "required": true,
          "timeout": 120000
        },
        {
          "name": "feature_tests",
          "command": "php artisan test --testsuite=Feature",
          "description": "Run feature test suite",
          "required": true,
          "timeout": 300000
        },
        {
          "name": "coverage_check",
          "command": "php artisan test --coverage --min=80",
          "description": "Verify test coverage threshold",
          "optional": true
        }
      ]
    },
    "security": {
      "enabled": true,
      "priority": "critical",
      "checks": [
        {
          "name": "dependency_audit",
          "command": "composer audit",
          "description": "Check for security vulnerabilities",
          "required": true
        },
        {
          "name": "configuration_security",
          "script": "check_security_config.php",
          "description": "Validate security configuration",
          "required": true
        }
      ]
    },
    "performance": {
      "enabled": true,
      "priority": "high",
      "checks": [
        {
          "name": "autoloader_optimization",
          "command": "composer dump-autoload --optimize --no-dev",
          "description": "Optimize Composer autoloader",
          "required": true
        },
        {
          "name": "config_caching",
          "command": "php artisan config:cache",
          "description": "Cache configuration files",
          "required": true
        },
        {
          "name": "route_caching",
          "command": "php artisan route:cache",
          "description": "Cache application routes",
          "required": true
        }
      ]
    }
  },
  "actions": [
    {
      "name": "pre_deployment_validation",
      "type": "sequential_execution",
      "description": "Run all pre-deployment validation checks",
      "steps": [
        {
          "name": "git_status_check",
          "command": "git status --porcelain",
          "validation": "empty_output",
          "errorMessage": "Working directory must be clean before deployment"
        },
        {
          "name": "branch_validation",
          "command": "git rev-parse --abbrev-ref HEAD",
          "validation": "allowed_branches",
          "allowedBranches": ["main", "master", "production"]
        }
      ]
    },
    {
      "name": "code_quality_validation",
      "type": "parallel_execution",
      "description": "Validate code quality and formatting",
      "maxConcurrency": 3,
      "steps": [
        {
          "name": "format_check",
          "command": "vendor/bin/pint --test --verbose",
          "onError": {
            "type": "send_message",
            "message": "❌ Code formatting issues detected. Run: `vendor/bin/pint --dirty` to fix."
          }
        },
        {
          "name": "syntax_check",
          "command": "find app resources -name '*.php' -exec php -l {} + | grep -v 'No syntax errors'",
          "validation": "empty_output",
          "onError": {
            "type": "send_message",
            "message": "❌ PHP syntax errors detected. Please fix before deployment."
          }
        }
      ]
    },
    {
      "name": "comprehensive_testing",
      "type": "sequential_execution",
      "description": "Run complete test suite",
      "steps": [
        {
          "name": "database_setup",
          "command": "php artisan migrate:fresh --seed --env=testing",
          "description": "Prepare test database"
        },
        {
          "name": "run_tests",
          "command": "php artisan test --parallel --processes=4",
          "timeout": 600000,
          "onSuccess": {
            "type": "send_message",
            "message": "✅ All tests passed! Application is ready for deployment."
          },
          "onError": {
            "type": "send_message",
            "message": "❌ Test failures detected. Deployment blocked until tests pass.\n\nRun failed tests: `php artisan test --filter={failedTests}`"
          }
        }
      ]
    },
    {
      "name": "security_validation",
      "type": "sequential_execution",
      "description": "Comprehensive security checks",
      "steps": [
        {
          "name": "dependency_audit",
          "command": "composer audit --format=json",
          "onError": {
            "type": "send_message",
            "message": "🚨 Security vulnerabilities found in dependencies. Update packages before deployment: `composer update`"
          }
        },
        {
          "name": "environment_security",
          "script": "validate_production_config.php",
          "inputs": {
            "environment": "production",
            "configFiles": [".env.example", "config/app.php"]
          }
        }
      ]
    },
    {
      "name": "asset_optimization",
      "type": "conditional_execution",
      "condition": {
        "type": "file_exists",
        "path": "package.json"
      },
      "steps": [
        {
          "name": "install_dependencies",
          "command": "npm ci --production",
          "description": "Install production dependencies"
        },
        {
          "name": "build_assets",
          "command": "npm run build",
          "timeout": 180000,
          "onSuccess": {
            "type": "validate_build_output",
            "manifestPath": "public/build/manifest.json"
          }
        }
      ]
    },
    {
      "name": "deployment_artifacts",
      "type": "parallel_execution",
      "description": "Prepare deployment artifacts",
      "steps": [
        {
          "name": "create_deployment_package",
          "script": "create_deployment_package.php",
          "inputs": {
            "version": "{gitTag}",
            "environment": "production"
          }
        },
        {
          "name": "generate_changelog",
          "command": "git log --oneline --since='1 week ago' > CHANGELOG.md",
          "description": "Generate deployment changelog"
        }
      ]
    }
  ],
  "postActions": [
    {
      "type": "deployment_readiness_report",
      "format": "html",
      "outputPath": "storage/deployment-reports/",
      "includeTimestamp": true,
      "sections": [
        "validation_results",
        "test_summary",
        "security_status",
        "performance_metrics",
        "deployment_checklist"
      ]
    },
    {
      "type": "rollback_preparation",
      "enabled": true,
      "actions": [
        "create_database_backup",
        "tag_current_release",
        "prepare_rollback_scripts"
      ]
    },
    {
      "type": "deployment_notification",
      "channels": ["slack", "email"],
      "recipients": ["deployment-team"],
      "includeArtifacts": true
    }
  ],
  "rollbackPreparation": {
    "enabled": true,
    "strategies": [
      {
        "name": "database_backup",
        "command": "php artisan backup:run --only-db",
        "description": "Create database backup before deployment"
      },
      {
        "name": "code_snapshot",
        "command": "git tag deployment-backup-{timestamp}",
        "description": "Tag current state for rollback"
      },
      {
        "name": "asset_backup",
        "command": "cp -r public/build public/build.backup",
        "description": "Backup compiled assets"
      }
    ]
  },
  "deploymentStrategies": {
    "blue_green": {
      "description": "Zero-downtime blue-green deployment",
      "steps": [
        "prepare_green_environment",
        "deploy_to_green",
        "run_health_checks",
        "switch_traffic",
        "monitor_metrics"
      ]
    },
    "rolling": {
      "description": "Rolling deployment with gradual traffic shift",
      "steps": [
        "deploy_to_subset",
        "health_check",
        "gradual_rollout",
        "full_deployment"
      ]
    },
    "canary": {
      "description": "Canary deployment with monitoring",
      "steps": [
        "deploy_canary",
        "monitor_metrics",
        "gradual_increase",
        "full_rollout"
      ]
    }
  },
  "notifications": {
    "validationStart": {
      "title": "Deployment Validation Started",
      "message": "🚀 Running pre-deployment checks...",
      "showProgress": true,
      "estimatedDuration": "5-10 minutes"
    },
    "validationFailed": {
      "title": "Deployment Blocked",
      "message": "❌ Pre-deployment validation failed",
      "icon": "🚫",
      "duration": 15000,
      "priority": "high",
      "actions": [
        {
          "label": "View Issues",
          "action": "open_validation_report"
        },
        {
          "label": "Fix & Retry",
          "action": "retry_validation"
        }
      ]
    },
    "deploymentReady": {
      "title": "Deployment Ready",
      "message": "✅ All checks passed - ready for deployment",
      "icon": "🚀",
      "duration": 8000,
      "actions": [
        {
          "label": "Deploy Now",
          "action": "start_deployment"
        },
        {
          "label": "View Report",
          "action": "open_deployment_report"
        }
      ]
    }
  },
  "analytics": {
    "trackUsage": true,
    "metrics": [
      "validation_frequency",
      "success_rate",
      "validation_duration",
      "failure_patterns",
      "deployment_frequency"
    ],
    "reporting": {
      "weekly": true,
      "includeSuccessMetrics": true,
      "trackImprovements": true
    }
  },
  "logging": {
    "enabled": true,
    "level": "info",
    "includeValidationDetails": true,
    "includeTestResults": true,
    "separateDeploymentLogs": true,
    "rotateDaily": true,
    "maxFiles": 60
  },
  "metadata": {
    "author": "Kiro Development Team",
    "created": "2024-12-10",
    "version": "2.0.0",
    "tags": ["deployment", "validation", "testing", "security", "automation"],
    "documentation": "Comprehensive deployment preparation system with automated validation, testing, and rollback preparation.",
    "dependencies": ["git", "composer", "php-artisan"],
    "compatibleWith": ["Laravel 11+", "Git 2+", "Composer 2+"],
    "optionalDependencies": ["npm", "phpstan", "phpunit"]
  }
}