{
  "enabled": true,
  "name": "Laravel 12 Event System Management",
  "description": "Event and listener creation workflow for Laravel 12",
  "version": "2.0",
  "when": {
    "type": "fileCreated",
    "patterns": ["app/Events/*.php", "app/Listeners/*.php"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Event or listener has been created. Please review Laravel 12 event system best practices:\n\n1. **Constructor Promotion**: Use constructor property promotion in events\n2. **Broadcasting**: Implement ShouldBroadcast interface for real-time updates\n3. **Queuing**: Add ShouldQueue to listeners for async processing\n4. **Type Hints**: Use proper type hints in event data\n5. **Registration**: Register events in bootstrap/providers.php if needed\n6. **Error Handling**: Implement proper error handling in listeners\n7. **Discovery**: Use event discovery for auto-registration\n8. **Logging**: Add proper logging for debugging\n\nRun `php artisan event:list` to verify event registration."
  }
}