{
  "name": "Laravel 12 Model Creation Workflow",
  "description": "Comprehensive model creation workflow with Laravel 12 best practices",
  "version": "2.0",
  "triggers": [
    {
      "type": "file_created",
      "patterns": ["app/Models/*.php"]
    }
  ],
  "actions": [
    {
      "type": "sequence",
      "steps": [
        {
          "type": "message",
          "content": "🏗️ New Model Created! Laravel 12 Model Checklist:\n\n✅ Use `casts()` method instead of `$casts` property\n✅ Add proper return types to relationships\n✅ Create factory: `php artisan make:factory {{ModelName}}Factory`\n✅ Create seeder: `php artisan make:seeder {{ModelName}}Seeder`\n✅ Create migration if needed: `php artisan make:migration create_{{table_name}}_table`\n✅ Add proper PHPDoc blocks\n✅ Use constructor property promotion\n✅ Prevent N+1 queries with eager loading"
        },
        {
          "type": "command",
          "command": "vendor/bin/pint --dirty",
          "description": "Format new model with Pint"
        }
      ]
    }
  ],
  "enabled": true,
  "priority": "high"
}