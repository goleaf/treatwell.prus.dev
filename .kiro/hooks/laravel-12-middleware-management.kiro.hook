{
  "name": "Laravel 12 Middleware Management",
  "description": "Middleware creation and registration workflow for Laravel 12",
  "version": "2.0",
  "triggers": [
    {
      "type": "file_created",
      "patterns": ["app/Http/Middleware/*.php"]
    },
    {
      "type": "file_saved",
      "patterns": ["bootstrap/app.php"]
    }
  ],
  "actions": [
    {
      "type": "sequence",
      "steps": [
        {
          "type": "message",
          "content": "🛡️ Laravel 12 Middleware Management:\n\n✅ Register in bootstrap/app.php using withMiddleware()\n✅ Use proper type hints in handle() method\n✅ Implement proper error handling\n✅ Add middleware to appropriate groups\n✅ Configure middleware aliases\n✅ Test middleware functionality\n✅ Consider performance impact\n✅ Add proper documentation"
        },
        {
          "type": "command",
          "command": "php artisan route:list --middleware",
          "description": "List routes with middleware"
        }
      ]
    }
  ],
  "enabled": true,
  "priority": "high"
}