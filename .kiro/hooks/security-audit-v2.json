{
  "name": "Comprehensive Security Auditor v2",
  "description": "Advanced security analysis system with vulnerability detection, dependency scanning, and compliance checking",
  "version": "2.0",
  "enabled": true,
  "priority": 5,
  "trigger": {
    "type": "manual",
    "additionalTriggers": [
      {
        "type": "scheduled",
        "schedule": "0 9 * * 1",
        "description": "Weekly security audit every Monday at 9 AM"
      },
      {
        "type": "file_save",
        "filePattern": [
          "composer.json",
          "package.json",
          ".env.example",
          "config/auth.php",
          "config/session.php"
        ]
      }
    ]
  },
  "preValidation": [
    {
      "type": "environment_check",
      "checks": [
        {
          "command": "composer --version",
          "required": true,
          "errorMessage": "Composer not found"
        },
        {
          "command": "php --version",
          "required": true,
          "minVersion": "8.3.0",
          "errorMessage": "PHP 8.3+ required for security features"
        }
      ]
    },
    {
      "type": "security_tools_check",
      "tools": [
        {
          "name": "composer-audit",
          "command": "composer audit --help",
          "installCommand": "composer global require composer/composer"
        },
        {
          "name": "security-checker",
          "command": "security-checker --version",
          "installCommand": "composer global require sensiolabs/security-checker",
          "optional": true
        }
      ]
    }
  ],
  "securityChecks": {
    "dependencyVulnerabilities": {
      "enabled": true,
      "priority": "critical",
      "tools": [
        {
          "name": "composer_audit",
          "command": "composer audit --format=json",
          "description": "Check PHP dependencies for known vulnerabilities"
        },
        {
          "name": "npm_audit",
          "command": "npm audit --json",
          "description": "Check Node.js dependencies for vulnerabilities",
          "optional": true
        }
      ]
    },
    "configurationSecurity": {
      "enabled": true,
      "priority": "high",
      "checks": [
        {
          "name": "debug_mode_check",
          "description": "Ensure APP_DEBUG is false in production",
          "file": ".env",
          "pattern": "APP_DEBUG=false",
          "severity": "critical"
        },
        {
          "name": "app_key_check",
          "description": "Verify APP_KEY is set and strong",
          "file": ".env",
          "pattern": "APP_KEY=base64:.{40,}",
          "severity": "critical"
        },
        {
          "name": "session_security",
          "description": "Check session security configuration",
          "file": "config/session.php",
          "checks": [
            "secure => true",
            "http_only => true",
            "same_site => 'strict'"
          ]
        }
      ]
    },
    "codeVulnerabilities": {
      "enabled": true,
      "priority": "high",
      "patterns": [
        {
          "name": "sql_injection",
          "pattern": "DB::raw\\(.*\\$.*\\)",
          "description": "Potential SQL injection vulnerability",
          "severity": "critical",
          "suggestion": "Use parameter binding instead of string concatenation"
        },
        {
          "name": "xss_vulnerability",
          "pattern": "\\{\\{\\{.*\\$.*\\}\\}\\}",
          "description": "Unescaped output in Blade templates",
          "severity": "high",
          "suggestion": "Use {{ }} instead of {{{ }}} for automatic escaping"
        },
        {
          "name": "hardcoded_secrets",
          "pattern": "(password|secret|key|token)\\s*=\\s*['\"][^'\"]{8,}['\"]",
          "description": "Hardcoded secrets detected",
          "severity": "critical",
          "suggestion": "Move secrets to environment variables"
        }
      ]
    },
    "filePermissions": {
      "enabled": true,
      "priority": "medium",
      "checks": [
        {
          "path": "storage",
          "expectedPermissions": "755",
          "recursive": true
        },
        {
          "path": ".env",
          "expectedPermissions": "600"
        },
        {
          "path": "bootstrap/cache",
          "expectedPermissions": "755"
        }
      ]
    }
  },
  "actions": [
    {
      "name": "dependency_vulnerability_scan",
      "type": "shell_command",
      "command": "composer audit --format=json",
      "description": "Scan PHP dependencies for vulnerabilities",
      "parseOutput": true,
      "outputParser": {
        "type": "composer_audit",
        "extractVulnerabilities": true,
        "categorizeByseverity": true
      },
      "onSuccess": {
        "type": "conditional_action",
        "condition": {
          "type": "vulnerabilities_found"
        },
        "action": {
          "type": "notification",
          "title": "Security Vulnerabilities Found",
          "message": "🚨 {vulnerabilityCount} vulnerabilities detected",
          "actions": [
            {
              "type": "send_message",
              "message": "🛡️ **Security Audit Results**\n\n🚨 **Critical Issues Found:**\n{criticalVulnerabilities}\n\n⚠️ **High Priority Issues:**\n{highVulnerabilities}\n\n**Recommended Actions:**\n1. Update vulnerable packages: `composer update`\n2. Review security advisories\n3. Test application after updates\n4. Consider alternative packages if updates unavailable\n\nRun detailed audit: `composer audit --verbose`"
            }
          ]
        }
      }
    },
    {
      "name": "configuration_security_check",
      "type": "custom_script",
      "script": "security_config_checker.php",
      "description": "Analyze configuration files for security issues",
      "inputs": {
        "configFiles": [
          ".env",
          "config/auth.php",
          "config/session.php",
          "config/cors.php"
        ]
      },
      "onSuccess": {
        "type": "generate_security_report",
        "includeRecommendations": true
      }
    },
    {
      "name": "code_vulnerability_scan",
      "type": "shell_command",
      "command": "grep -r -n --include='*.php' '{securityPattern}' app/ resources/",
      "description": "Scan code for common vulnerability patterns",
      "iterations": "{securityPatterns}",
      "onSuccess": {
        "type": "conditional_action",
        "condition": {
          "type": "matches_found"
        },
        "action": {
          "type": "send_message",
          "message": "🔍 **Code Security Issues Detected**\n\n{vulnerabilityMatches}\n\n**Review Required:**\nPlease review the flagged code sections and apply security best practices."
        }
      }
    },
    {
      "name": "file_permission_audit",
      "type": "shell_command",
      "command": "find . -type f -name '*.php' -perm /o+w",
      "description": "Check for world-writable PHP files",
      "onSuccess": {
        "type": "conditional_action",
        "condition": {
          "type": "files_found"
        },
        "action": {
          "type": "send_message",
          "message": "⚠️ **File Permission Issues**\n\nWorld-writable PHP files found:\n{writableFiles}\n\nFix permissions: `chmod 644 {files}`"
        }
      }
    },
    {
      "name": "environment_security_check",
      "type": "custom_logic",
      "checks": [
        {
          "name": "production_debug_check",
          "condition": "APP_ENV=production AND APP_DEBUG=true",
          "severity": "critical",
          "message": "Debug mode enabled in production environment"
        },
        {
          "name": "default_keys_check",
          "condition": "APP_KEY contains 'base64:' AND length < 50",
          "severity": "high",
          "message": "Weak or default application key detected"
        }
      ]
    }
  ],
  "postActions": [
    {
      "type": "generate_security_report",
      "format": "html",
      "outputPath": "storage/security-reports/",
      "includeTimestamp": true,
      "sections": [
        "executive_summary",
        "vulnerability_details",
        "recommendations",
        "compliance_status"
      ]
    },
    {
      "type": "security_score_calculation",
      "factors": [
        "vulnerability_count",
        "severity_levels",
        "configuration_issues",
        "code_quality"
      ],
      "thresholds": {
        "excellent": 95,
        "good": 85,
        "fair": 70,
        "poor": 50
      }
    },
    {
      "type": "compliance_check",
      "standards": [
        "OWASP_Top_10",
        "Laravel_Security_Best_Practices",
        "PHP_Security_Guidelines"
      ]
    }
  ],
  "complianceFrameworks": {
    "OWASP_Top_10": {
      "checks": [
        "injection_vulnerabilities",
        "broken_authentication",
        "sensitive_data_exposure",
        "xml_external_entities",
        "broken_access_control",
        "security_misconfiguration",
        "cross_site_scripting",
        "insecure_deserialization",
        "vulnerable_components",
        "insufficient_logging"
      ]
    },
    "Laravel_Security": {
      "checks": [
        "csrf_protection",
        "sql_injection_prevention",
        "xss_protection",
        "authentication_security",
        "authorization_implementation",
        "session_security",
        "file_upload_security"
      ]
    }
  },
  "notifications": {
    "auditStart": {
      "title": "Security Audit Started",
      "message": "🔍 Running comprehensive security analysis...",
      "showProgress": true
    },
    "criticalVulnerabilities": {
      "title": "Critical Security Issues",
      "message": "🚨 {count} critical vulnerabilities found",
      "icon": "🚨",
      "duration": 15000,
      "priority": "high",
      "actions": [
        {
          "label": "View Report",
          "action": "open_security_report"
        },
        {
          "label": "Fix Now",
          "action": "run_security_fixes"
        }
      ]
    },
    "auditComplete": {
      "title": "Security Audit Complete",
      "message": "✅ Security score: {securityScore}/100",
      "icon": "🛡️",
      "duration": 8000,
      "actions": [
        {
          "label": "View Full Report",
          "action": "open_security_report"
        }
      ]
    }
  },
  "remediation": {
    "autoFix": {
      "enabled": false,
      "safeOperations": [
        "update_composer_dependencies",
        "fix_file_permissions",
        "update_configuration_defaults"
      ]
    },
    "suggestions": {
      "dependency_updates": "Run `composer update` to fix known vulnerabilities",
      "configuration_fixes": "Update configuration files based on security recommendations",
      "code_improvements": "Apply secure coding practices to flagged code sections"
    }
  },
  "analytics": {
    "trackUsage": true,
    "metrics": [
      "audit_frequency",
      "vulnerability_trends",
      "security_score_history",
      "remediation_time",
      "compliance_status"
    ],
    "reporting": {
      "weekly": true,
      "monthly": true,
      "includeComparisons": true
    }
  },
  "logging": {
    "enabled": true,
    "level": "info",
    "includeVulnerabilityDetails": true,
    "separateSecurityLogs": true,
    "encryptSensitiveData": true,
    "rotateDaily": true,
    "maxFiles": 90
  },
  "metadata": {
    "author": "Kiro Development Team",
    "created": "2024-12-10",
    "version": "2.0.0",
    "tags": ["security", "audit", "vulnerability", "compliance", "automation"],
    "documentation": "Comprehensive security auditing system with vulnerability detection, compliance checking, and automated remediation suggestions.",
    "dependencies": ["composer", "php-cli", "grep", "find"],
    "compatibleWith": ["Laravel 11+", "PHP 8.3+", "Composer 2+"]
  }
}