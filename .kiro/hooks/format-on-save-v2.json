{
  "name": "Advanced Code Formatter v2",
  "description": "Comprehensive code formatting and quality checks on PHP file save with detailed feedback and validation",
  "version": "2.0",
  "enabled": true,
  "priority": 1,
  "trigger": {
    "type": "file_save",
    "filePattern": "*.php",
    "excludePatterns": [
      "vendor/*",
      "storage/*",
      "bootstrap/cache/*",
      "node_modules/*"
    ],
    "conditions": {
      "minFileSize": 10,
      "maxFileSize": 1048576,
      "requireGitTracked": true,
      "skipIfErrors": true
    },
    "debounce": 1000
  },
  "preValidation": [
    {
      "type": "environment_check",
      "checks": [
        {
          "command": "vendor/bin/pint --version",
          "required": true,
          "errorMessage": "Laravel Pint not found. Install with: composer require laravel/pint --dev"
        },
        {
          "command": "php --version",
          "required": true,
          "errorMessage": "PHP CLI not available"
        }
      ]
    },
    {
      "type": "file_validation",
      "checks": [
        {
          "type": "syntax_check",
          "command": "php -l {filePath}",
          "errorMessage": "PHP syntax error detected. Fix syntax before formatting."
        },
        {
          "type": "file_size",
          "maxSize": "1MB",
          "errorMessage": "File too large for automatic formatting"
        }
      ]
    }
  ],
  "actions": [
    {
      "name": "format_code",
      "type": "shell_command",
      "command": "vendor/bin/pint --dirty --verbose",
      "workingDirectory": "{projectRoot}",
      "timeout": 30000,
      "retries": 2,
      "retryDelay": 1000,
      "environment": {
        "PINT_CONFIG": "pint.json"
      },
      "onSuccess": {
        "type": "notification",
        "title": "Code Formatted Successfully",
        "message": "✅ {fileName} formatted with Laravel Pint",
        "actions": [
          {
            "type": "send_message",
            "message": "Code formatting completed successfully. File now complies with project standards."
          }
        ]
      },
      "onError": {
        "type": "notification",
        "title": "Formatting Failed",
        "message": "❌ Failed to format {fileName}",
        "actions": [
          {
            "type": "send_message",
            "message": "⚠️ Pint formatting failed for {fileName}. Please check for syntax errors and run manually: `vendor/bin/pint {filePath}`"
          },
          {
            "type": "log_error",
            "level": "warning",
            "message": "Pint formatting failed: {error}"
          }
        ]
      }
    },
    {
      "name": "validate_syntax",
      "type": "shell_command",
      "command": "php -l {filePath}",
      "description": "Post-format syntax validation",
      "onSuccess": {
        "type": "log",
        "level": "info",
        "message": "PHP syntax validation passed for {filePath}"
      },
      "onError": {
        "type": "send_message",
        "message": "🚨 Syntax error after formatting in {fileName}. Please review the changes."
      }
    }
  ],
  "postActions": [
    {
      "type": "conditional_action",
      "condition": {
        "type": "file_contains",
        "pattern": "(class|interface|trait)\\s+\\w+",
        "flags": "i"
      },
      "action": {
        "type": "send_message",
        "message": "💡 Tip: Consider running tests for this class: `php artisan test --filter={className}`"
      }
    },
    {
      "type": "conditional_action",
      "condition": {
        "type": "file_path_matches",
        "pattern": "app/Http/Controllers/*"
      },
      "action": {
        "type": "send_message",
        "message": "🎯 Controller updated. Consider testing the related routes and endpoints."
      }
    },
    {
      "type": "conditional_action",
      "condition": {
        "type": "file_path_matches",
        "pattern": "app/Models/*"
      },
      "action": {
        "type": "send_message",
        "message": "📊 Model updated. Consider running related database tests and checking relationships."
      }
    }
  ],
  "analytics": {
    "trackUsage": true,
    "metrics": [
      "execution_time",
      "success_rate",
      "file_size",
      "error_types"
    ]
  },
  "notifications": {
    "success": {
      "title": "Code Formatted",
      "message": "PHP file formatted and validated successfully",
      "icon": "✅",
      "duration": 3000
    },
    "error": {
      "title": "Formatting Failed",
      "message": "Code formatting encountered issues",
      "icon": "❌",
      "duration": 5000,
      "actions": [
        {
          "label": "View Logs",
          "action": "open_logs"
        },
        {
          "label": "Run Manually",
          "action": "open_terminal",
          "command": "vendor/bin/pint {filePath}"
        }
      ]
    }
  },
  "logging": {
    "enabled": true,
    "level": "info",
    "includeFileContent": false,
    "includeTimestamp": true,
    "rotateDaily": true,
    "maxFiles": 7
  },
  "metadata": {
    "author": "Kiro Development Team",
    "created": "2024-12-10",
    "version": "2.0.0",
    "tags": ["formatting", "php", "laravel", "quality", "automation"],
    "documentation": "Advanced PHP code formatter with comprehensive validation, error handling, and contextual feedback.",
    "dependencies": ["laravel/pint", "php-cli"],
    "compatibleWith": ["Laravel 11+", "PHP 8.3+"]
  }
}