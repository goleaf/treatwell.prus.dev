{
  "enabled": true,
  "name": "Code Quality Analyzer",
  "description": "Monitors source code files for changes and provides automated code quality analysis including code smells, design patterns, best practices, readability, maintainability, and performance optimization suggestions",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "app/**/*.php",
      "resources/**/*.php",
      "database/**/*.php",
      "tests/**/*.php",
      "config/**/*.php",
      "routes/**/*.php"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Analyze the modified code in the following file for potential improvements. Focus on:\n\n1. **Code Smells**: Identify any code smells such as long methods, large classes, duplicate code, or complex conditionals\n2. **Design Patterns**: Suggest appropriate design patterns that could improve the code structure\n3. **Best Practices**: Check adherence to Laravel conventions, PHP best practices, and project-specific guidelines\n4. **Readability**: Evaluate code clarity, naming conventions, and documentation\n5. **Maintainability**: Assess how easy the code is to modify and extend\n6. **Performance**: Identify potential performance bottlenecks and optimization opportunities\n\nPlease provide specific, actionable suggestions while maintaining the existing functionality. Consider the Laravel ecosystem, PHP 8.3+ features, and the project's established patterns."
  }
}