{
  "name": "Laravel 12 Test Automation",
  "description": "Comprehensive PHPUnit testing workflow for Laravel 12",
  "version": "2.0",
  "triggers": [
    {
      "type": "file_saved",
      "patterns": [
        "tests/**/*.php",
        "app/Http/Controllers/*.php",
        "app/Models/*.php",
        "app/Services/*.php"
      ]
    }
  ],
  "actions": [
    {
      "type": "sequence",
      "steps": [
        {
          "type": "message",
          "content": "🧪 Running Laravel 12 PHPUnit Tests...\n\n✅ Testing happy paths, failure paths, and edge cases\n✅ Using model factories for test data\n✅ Following PHPUnit conventions (not Pest)\n✅ Isolated test execution"
        },
        {
          "type": "command",
          "command": "php artisan test --filter={{test_method_name}} --stop-on-failure",
          "description": "Run specific test method",
          "condition": "file_matches('tests/**/*.php')"
        },
        {
          "type": "command",
          "command": "php artisan test tests/Feature/{{controller_name}}Test.php",
          "description": "Run controller tests",
          "condition": "file_matches('app/Http/Controllers/*.php')"
        },
        {
          "type": "command",
          "command": "php artisan test tests/Unit/{{model_name}}Test.php",
          "description": "Run model tests",
          "condition": "file_matches('app/Models/*.php')"
        }
      ]
    }
  ],
  "enabled": true,
  "priority": "high"
}